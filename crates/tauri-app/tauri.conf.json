{
  "productName": "CodeForge",
  "identifier": "net.swofty.codeforge",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "./frontend/dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": {
      "script": "npm install && npm run build",
      "cwd": "./frontend"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CodeForge",
        "width": 1280,
        "height": 820,
        "center": true,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"],
    "resources": [
      "agent-sidecar/index.mjs",
      "agent-sidecar/node_modules/**/*",
      "agent-sidecar/package.json"
    ]
  }
}
